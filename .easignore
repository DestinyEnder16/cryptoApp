# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

app-example


# generated native folders (iOS is regenerated by prebuild; Android is shipped)
/ios

# Android build artifacts — the android/ folder is shipped, but its generated
# build output must not be. (.easignore replaces .gitignore, so android/.gitignore
# is NOT consulted by EAS; these have to be listed here explicitly.)
android/build/
android/.gradle/
android/.kotlin/
android/.idea/
android/local.properties
android/app/build/
android/**/.cxx/
android/**/build/
*.iml
*.hprof
*.jsbundle
*.keystore
